{
  "name": "dystopian-wars-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:publish && npm run assistant:publish && tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types --check && tsc -b --pretty false",
    "types:generate": "wrangler types",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:catalog": "vitest run --config vitest.catalog.config.mjs",
    "test:catalog:real": "node scripts/catalog/real-integration.mjs",
    "test:catalog:policy": "node scripts/catalog/check-policy.mjs",
    "test:catalog:bundle": "node scripts/catalog/check-bundle.mjs",
    "test:domain": "vitest run src/domain/catalog/catalog.test.ts --config vitest.config.ts",
    "test:roster": "vitest run src/domain/roster/roster.test.ts --config vitest.config.ts",
    "test:domain:real": "vitest run --config vitest.domain-real.config.mjs",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "preview:smoke": "node scripts/smoke-preview.mjs",
    "test:e2e:smoke": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "catalog": "node scripts/catalog/cli.mjs",
    "catalog:publish": "tsx scripts/catalog/publish-runtime.ts",
    "assistant:publish": "node scripts/assistant/publish-rules-corpus.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm run test:catalog:policy && npm run test:unit && npm run test:catalog && npm run test:domain:real && npm run test:worker && npm run build && npm run test:catalog:bundle && npm run test:e2e:smoke"
  },
  "dependencies": {
    "hono": "4.12.33",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "saxes": "6.0.0",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
